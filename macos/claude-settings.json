{
  "env": {
    "ENABLE_TOOL_SEARCH": "false"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Task",
      "mcp__lobster-inbox",
      "mcp__clawdaddy-approval"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/1Password/**)",
      "Read(~/Library/Group Containers/*1password*/**)",
      "Read(~/Library/Group Containers/*1Password*/**)",
      "Read(~/.config/clawdaddy/**)",
      "Read(~/.config/openclaw/**)",
      "Read(~/.freedom/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/lobster/config/config.env)",
      "Read(~/.local/state/clawdaddy/**)",
      "Read(~/messages/inbox/**)",
      "Read(~/messages/config/**)",
      "Read(~/lobster-workspace/.claude/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/Library/Keychains/**)",
      "Edit(~/Library/Application Support/1Password/**)",
      "Edit(~/Library/Group Containers/*1password*/**)",
      "Edit(~/Library/Group Containers/*1Password*/**)",
      "Edit(~/.config/clawdaddy/**)",
      "Edit(~/.config/openclaw/**)",
      "Edit(~/.freedom/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/lobster/config/config.env)",
      "Edit(~/.local/state/clawdaddy/**)",
      "Edit(~/messages/inbox/**)",
      "Edit(~/messages/config/**)",
      "Edit(~/lobster-workspace/.claude/**)",
      "Read(~/messages/outbox/**)",
      "Edit(~/messages/outbox/**)",
      "Read(~/messages/sent/**)",
      "Edit(~/messages/sent/**)",
      "Edit(~/lobster/**)",
      "Edit(~/Library/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.config/**)",
      "Edit(~/.local/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.zlogin)",
      "Edit(~/.zlogout)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(//opt/homebrew/**)",
      "Edit(//usr/local/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "~/lobster-workspace"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/Library",
        "~/.freedom",
        "~/lobster",
        "~/messages",
        "~/.local/state/clawdaddy",
        "~/lobster-workspace/.claude"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/Library/Keychains",
        "~/Library/Application Support/1Password",
        "~/Library/Group Containers/*1password*",
        "~/Library/Group Containers/*1Password*",
        "~/.config/clawdaddy",
        "~/.config/openclaw",
        "~/.freedom",
        "~/.claude/.credentials.json",
        "~/lobster/config",
        "~/.local/state/clawdaddy",
        "~/messages/inbox",
        "~/messages/config",
        "~/lobster-workspace/.claude",
        "~/messages/outbox",
        "~/messages/sent"
      ]
    },
    "network": {
      "allowedDomains": [],
      "strictAllowlist": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/lobster/.venv/bin/python $HOME/lobster/macos/reach_guard.py || exit 2"
          }
        ]
      }
    ]
  }
}
