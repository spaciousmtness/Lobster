# macos/mac.env -- Clawdaddy launchd environment (committed; no secrets).
#
# Sourced by run-with-env.sh with `set -a`, after config/config.env. Values
# below may reference $HOME because run-with-env.sh sources this file in
# bash, which expands $HOME itself before the variable is exported -- unlike
# the plist templates and mcp.json.in, which launchd would never expand, and
# which use the @HOME@ placeholder install.sh substitutes at install time.
#
# LOBSTER_WAKE_CMD is intentionally NOT set here: it needs the literal
# numeric uid (src/bot/lobster_bot.py runs it without a shell and refuses a
# leftover $ in the command), and this file is committed to git, so it can
# never hardcode any one operator's uid. run-with-env.sh sets it after
# sourcing this file, from `id -u`, unless something upstream already set it.

LOBSTER_CLAUDE_FLAGS="--setting-sources= --settings $HOME/lobster/macos/claude-settings.json --mcp-config $HOME/lobster/macos/mcp.json --strict-mcp-config --permission-mode dontAsk --append-system-prompt-file $HOME/lobster/macos/CLAUDE.mac.md"
LOBSTER_CLAUDE_MATCH="claude.*lobster/macos/claude-settings.json"
ENABLE_TOOL_SEARCH=false
LOBSTER_UPDATE_REMOTE=upstream
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
